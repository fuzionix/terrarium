{
  "name": "terrarium",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:desktop": "pnpm --filter @terrarium/desktop tauri dev",
    "build:desktop": "pnpm --filter @terrarium/desktop tauri build",
    "storybook": "pnpm --filter @terrarium/desktop storybook",
    "build-storybook": "pnpm --filter @terrarium/desktop build-storybook",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "semver": "^7.6.3"
  }
}